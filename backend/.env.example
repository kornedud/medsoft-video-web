# Скопируйте в .env: cp .env.example .env
# Postgres из docker-compose этого репозитория (проброс на хост 5433):
DATABASE_URL=postgresql+asyncpg://teleconsult:teleconsult@localhost:5433/teleconsult
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BCRYPT_ROUNDS=12
# Подпись cookie-сессии; в production задайте длинную случайную строку
SESSION_SECRET=dev-only-set-SESSION_SECRET-in-production
# Срок cookie в секундах (по умолчанию 7 суток в коде)
# SESSION_MAX_AGE_SECONDS=604800
# В production задайте true (HTTPS)
COOKIE_SECURE=false
