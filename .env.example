# Backend — скопируйте в backend/.env или оставьте дефолты в app/config.py
# Postgres из docker-compose: с хоста порт 5433 (см. docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://teleconsult:teleconsult@localhost:5433/teleconsult
# Свой Postgres на стандартном порту:
# DATABASE_URL=postgresql+asyncpg://teleconsult:teleconsult@localhost:5432/teleconsult
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# cost factor bcrypt (4–31), по умолчанию 12
BCRYPT_ROUNDS=12
SESSION_SECRET=dev-only-set-SESSION_SECRET-in-production
COOKIE_SECURE=false

# Frontend (скопируйте в frontend/.env при необходимости)
# Пусто = в dev Vite проксирует /api на backend (см. vite.config.js)
# Явный URL = запросы с браузера напрямую на API (удобно в Docker)
VITE_API_URL=http://localhost:8000

# TURN-сервер (для production; в dev достаточно STUN)
# VITE_TURN_URL=turn:call.example.com:3478
# VITE_TURN_USER=teleconsult
# VITE_TURN_PASS=turn-password
